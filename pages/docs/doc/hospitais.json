{
  "tags": [
    {
      "name": "HOSPITAIS",
      "description": "Hospitais de referência habilitados pelo SUS, por vertical de atendimento: animais peçonhentos (soros antiveneno), oncologia (habilitações CGCAN) e doenças raras (habilitações SRDR/SAE). Inclui também os centros CIATOX de informação e assistência toxicológica.\n\n> ⚠️ **Em emergência, ligue 192 (SAMU).** Esta API não substitui atendimento médico. Em caso de acidente com animal peçonhento ou intoxicação, ligue para o CIATOX da sua região **antes de se deslocar** — a unidade listada pode não ter o soro disponível no momento. Consulte `/hospitais/v1/ciatox`.\n\n**Procedência:** os dados são extraídos automaticamente de documentos públicos publicados pelo Ministério da Saúde em gov.br/saude (PDFs estaduais e planilhas de habilitação), pelo projeto [MapaSUS](https://mapasus.com.br).\n\n**Este não é um serviço oficial do Ministério da Saúde.** Nem o MapaSUS nem a BrasilAPI possuem vínculo com o órgão. Os dados podem conter erros de extração ou estar desatualizados em relação à fonte oficial — cada resposta traz `fonte.oficial: false` e a data da última coleta em `atualizado_em`.\n\n**Qualidade dos dados:** parte dos registros é extraída de PDFs por OCR. O campo `requires_verification` indica quando a extração teve confiança baixa e o registro merece verificação manual antes de uso crítico."
    }
  ],
  "paths": {
    "/hospitais/v1": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Lista hospitais de referência do SUS com filtros por vertical, UF, município e habilitação",
        "description": "Retorna os hospitais de referência habilitados pelo SUS. Sem filtros, devolve o conjunto completo paginado. As buscas por município e texto livre são case-insensitive e acento-insensitive.",
        "parameters": [
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "peconhentos",
                "oncologia",
                "raras"
              ]
            },
            "description": "Vertical de atendimento. `peconhentos` são os hospitais com soro antiveneno; `oncologia` são as habilitações CGCAN (CACON, UNACON, radioterapia); `raras` são as habilitações SRDR/SAE.",
            "example": "peconhentos"
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "Sigla da unidade federativa.",
            "example": "SP"
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca parcial pelo nome do município (ignora acentos e caixa).",
            "example": "campinas"
          },
          {
            "name": "atendimento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca única que atravessa as três verticais. Aceita nome popular do animal (`cascavel`, `jararaca`, `armadeira`, `lagarta`), nome do soro em português ou inglês (`crotalico`, `Crotalic`), habilitação de oncologia (`radioterapia`, `cacon`, `unacon`), área de doenças raras (`terapia-genica`, `doencas-autoimunes`) ou código de portaria (`17.07`, `35.16`).\n\nAcento, caixa, hífen, underscore e espaço são equivalentes. Um termo fora do vocabulário retorna 400 em vez de lista vazia — consulte `/hospitais/v1/opcoes` para os valores aceitos.",
            "example": "cascavel"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca livre por nome ou endereço do estabelecimento.",
            "example": "santa casa"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "description": "Quantidade máxima de itens a retornar. Valores acima de 500 são limitados a 500.",
            "example": 50
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Deslocamento inicial para paginação.",
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitaisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/hospitais/v1/proximos": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Busca hospitais de referência por proximidade geográfica",
        "description": "Retorna os hospitais dentro de um raio a partir de uma origem, ordenados pela distância crescente. A origem pode ser informada de três formas: por `cep`, por `latitude` e `longitude`, ou por `municipio` e `uf`. Somente hospitais com coordenadas conhecidas entram no resultado.",
        "parameters": [
          {
            "name": "cep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "CEP de origem. Alternativo a `latitude`/`longitude` e a `municipio`/`uf`.",
            "example": "13280000"
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "description": "Latitude de origem. Deve ser usada junto de `longitude`.",
            "example": -22.9
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "description": "Longitude de origem. Deve ser usada junto de `latitude`.",
            "example": -47.05
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Município de origem. Deve ser usado junto de `uf`.",
            "example": "Vinhedo"
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "UF de origem. Deve ser usada junto de `municipio`.",
            "example": "SP"
          },
          {
            "name": "raio_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 200,
              "default": 50
            },
            "description": "Raio da busca em quilômetros.",
            "example": 50
          },
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "peconhentos",
                "oncologia",
                "raras"
              ]
            },
            "description": "Restringe a busca a uma vertical de atendimento.",
            "example": "peconhentos"
          },
          {
            "name": "atendimento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restringe a busca a um atendimento específico, atravessando as três verticais. Mesmos valores e aliases de `/hospitais/v1`.",
            "example": "cascavel"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            },
            "description": "Quantidade máxima de itens a retornar.",
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Deslocamento inicial para paginação.",
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitaisProximosResponse"
                }
              }
            }
          },
          "400": {
            "description": "Origem não informada ou parâmetro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/hospitais/v1/opcoes": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Lista os valores aceitos pelos filtros de busca, com contagem",
        "description": "Descreve o vocabulário da API: as verticais disponíveis e todos os atendimentos aceitos em `?atendimento=`, cada um com rótulo em português, grafias alternativas, códigos de portaria cobertos e a quantidade de estabelecimentos que o oferecem.\n\nUse este endpoint para montar seletores sem depender da documentação — todo valor listado em `atendimentos[].valor` é aceito pela busca.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpcoesResponse"
                }
              }
            }
          }
        },
        "parameters": []
      }
    },
    "/hospitais/v1/ciatox": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Lista os centros CIATOX de informação e assistência toxicológica",
        "description": "Retorna os Centros de Informação e Assistência Toxicológica (CIATOX). Em caso de acidente com animal peçonhento, a orientação oficial é ligar primeiro para o CIATOX da região antes de se deslocar.",
        "parameters": [
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "Sigla da unidade federativa.",
            "example": "SP"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CiatoxResponse"
                }
              }
            }
          },
          "400": {
            "description": "UF inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HospitalFonte": {
        "title": "HospitalFonte",
        "description": "Procedência dos dados. `oficial` é sempre `false`: os dados vêm de documentos públicos do Ministério da Saúde, mas nem o MapaSUS nem a BrasilAPI são serviços oficiais do órgão.",
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "MapaSUS"
          },
          "url": {
            "type": "string",
            "example": "https://mapasus.com.br"
          },
          "oficial": {
            "type": "boolean",
            "example": false
          },
          "documentos_de_origem": {
            "type": "string",
            "example": "Ministério da Saúde — gov.br/saude"
          },
          "aviso": {
            "type": "string",
            "example": "O MapaSUS e a BrasilAPI não são serviços oficiais do Ministério da Saúde e não possuem vínculo com o órgão. Os dados são extraídos automaticamente de documentos públicos publicados pelo Ministério da Saúde e podem conter erros de extração ou estar desatualizados em relação à fonte oficial."
          }
        }
      },
      "Emergencia": {
        "title": "Emergencia",
        "description": "Orientação de segurança devolvida em toda resposta. Exiba para o usuário final em qualquer interface construída sobre estes dados.",
        "type": "object",
        "properties": {
          "aviso": {
            "type": "string",
            "example": "Esta API não substitui atendimento médico. Em emergência, ligue 192 (SAMU). Em caso de acidente com animal peçonhento ou intoxicação, ligue para o CIATOX da sua região antes de se deslocar — a unidade listada pode não ter o soro disponível no momento."
          },
          "samu": {
            "type": "string",
            "example": "192"
          },
          "disque_intoxicacao": {
            "type": "string",
            "example": "0800 722 6001"
          },
          "ciatox": {
            "type": "string",
            "example": "/api/hospitais/v1/ciatox"
          }
        }
      },
      "Atendimento": {
        "title": "Atendimento",
        "type": "object",
        "properties": {
          "vertical": {
            "type": "string",
            "example": "peconhentos"
          },
          "valor": {
            "type": "string",
            "description": "Valor a passar em `?atendimento=`.",
            "example": "Crotalic"
          },
          "rotulo": {
            "type": "string",
            "example": "Crotálico (cascavel)"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Outras grafias aceitas para o mesmo atendimento.",
            "example": [
              "crotalico",
              "crotalus",
              "cascavel"
            ]
          },
          "codigos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Códigos de portaria cobertos. Presente apenas nas habilitações de oncologia e doenças raras.",
            "example": [
              "12",
              "13"
            ]
          },
          "total": {
            "type": "integer",
            "description": "Quantidade de estabelecimentos que oferecem este atendimento.",
            "example": 1093
          }
        }
      },
      "OpcoesResponse": {
        "title": "OpcoesResponse",
        "type": "object",
        "properties": {
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:14:12.630Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "verticais": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "valor": {
                  "type": "string",
                  "example": "peconhentos"
                },
                "total": {
                  "type": "integer",
                  "example": 2018
                }
              }
            }
          },
          "atendimentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atendimento"
            }
          }
        }
      },
      "HospitalHabilitacao": {
        "title": "HospitalHabilitacao",
        "type": "object",
        "properties": {
          "specialty": {
            "type": "string",
            "example": "unacon"
          },
          "habilitado_em": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "qualification_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "17.07"
            ]
          }
        }
      },
      "Hospital": {
        "title": "Hospital",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 806
          },
          "state_code": {
            "type": "string",
            "example": "AC"
          },
          "city": {
            "type": "string",
            "example": "Acrelândia"
          },
          "name": {
            "type": "string",
            "example": "Unidade Mista de Saúde de Acrelândia"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "Avenida Paraná, 346 – Centro"
          },
          "phones": {
            "type": "string",
            "nullable": true,
            "example": "(68) 3235-1188"
          },
          "cnes": {
            "type": "string",
            "nullable": true,
            "description": "Código do estabelecimento no Cadastro Nacional de Estabelecimentos de Saúde.",
            "example": "5701929"
          },
          "treatments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Soros antiveneno disponíveis. Preenchido na vertical `peconhentos`.",
            "example": [
              "Bothropic",
              "Scorpionic",
              "Loxoscelic",
              "Phoneutric"
            ]
          },
          "specialties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HospitalHabilitacao"
            },
            "description": "Habilitações oficiais. Preenchido nas verticais `oncologia` e `raras`."
          },
          "verticals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "venomous_animals"
            ]
          },
          "lat": {
            "type": "number",
            "nullable": true,
            "example": -10.0783325
          },
          "lng": {
            "type": "number",
            "nullable": true,
            "example": -67.0558239
          },
          "extraction_source": {
            "type": "string",
            "description": "Como o registro foi extraído da fonte oficial: `pdf_text`, `pdf_ocr` ou `xlsx`.",
            "example": "pdf_text"
          },
          "requires_verification": {
            "type": "boolean",
            "description": "Indica extração de baixa confiança — o registro merece verificação manual antes de uso crítico.",
            "example": false
          }
        }
      },
      "HospitalProximo": {
        "title": "HospitalProximo",
        "allOf": [
          {
            "$ref": "#/components/schemas/Hospital"
          },
          {
            "type": "object",
            "properties": {
              "distancia_metros": {
                "type": "integer",
                "example": 18432
              },
              "distancia_km": {
                "type": "number",
                "example": 18.4
              }
            }
          }
        ]
      },
      "CiatoxCentro": {
        "title": "CiatoxCentro",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "state_code": {
            "type": "string",
            "example": "AM"
          },
          "name": {
            "type": "string",
            "example": "Centro de Informações Toxicológicas do Amazonas – CIT/AM"
          },
          "emergency_phone": {
            "type": "string",
            "nullable": true,
            "example": "(92) 3305-4702"
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "0800-722-6001",
              "(92) 3305-4732"
            ]
          },
          "source_url": {
            "type": "string",
            "example": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/a/animais-peconhentos/ciatox"
          }
        }
      },
      "HospitaisResponse": {
        "title": "HospitaisResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total de registros que atendem ao filtro, antes da paginação.",
            "example": 245
          },
          "limit": {
            "type": "integer",
            "example": 100
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "description": "Data da última coleta do snapshot.",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hospital"
            }
          }
        }
      },
      "HospitaisProximosResponse": {
        "title": "HospitaisProximosResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 12
          },
          "limit": {
            "type": "integer",
            "example": 50
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "origem": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "example": -23.0299
              },
              "longitude": {
                "type": "number",
                "example": -46.9756
              }
            }
          },
          "raio_km": {
            "type": "number",
            "example": 50
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HospitalProximo"
            }
          }
        }
      },
      "CiatoxResponse": {
        "title": "CiatoxResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 32
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CiatoxCentro"
            }
          }
        }
      }
    }
  }
}
