{
  "tags": [
    {
      "name": "HOSPITAIS",
      "description": "Hospitais de referência do SUS para acidentes com animais peçonhentos, oncologia e doenças raras, e os centros CIATOX de assistência toxicológica. <b>Em emergência ligue 192 (SAMU)</b>; em acidente com peçonhento, ligue ao CIATOX antes de se deslocar. Extraído de documentos do Ministério da Saúde pelo projeto MapaSUS — <b>não é um serviço oficial do órgão</b>."
    }
  ],
  "paths": {
    "/hospitais/v1": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Pesquisa hospitais de referência do SUS",
        "description": "Todos os filtros são opcionais e se combinam com E lógico; sem nenhum, devolve o conjunto completo paginado. O filtro principal é <code>atendimento</code>, que sozinho descobre em qual das três verticais procurar — na maioria dos casos a busca precisa de um único parâmetro. Município e busca livre ignoram acento e caixa.",
        "parameters": [
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "peconhentos",
                "oncologia",
                "raras"
              ]
            },
            "description": "Restringe a uma categoria inteira. Opcional e raramente necessário, já que <code>atendimento</code> identifica a vertical sozinho. Use para listar tudo de uma categoria, como todos os hospitais de oncologia de um estado.",
            "example": "peconhentos"
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "Sigla da unidade federativa.",
            "example": "SP"
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca parcial pelo nome do município (ignora acentos e caixa).",
            "example": "campinas"
          },
          {
            "name": "atendimento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtro principal: um só termo e ele descobre a vertical. Aceita nome popular do animal (<code>escorpiao</code>, <code>cascavel</code>, <code>jararaca</code>), nome do soro (<code>crotalico</code>, <code>Crotalic</code>), habilitação (<code>radioterapia</code>, <code>cacon</code>, <code>terapia-genica</code>) ou código de portaria (<code>17.07</code>, <code>35.16</code>). Acento, caixa e hífen são indiferentes. Lista completa em <code>/hospitais/v1/opcoes</code>.",
            "example": "escorpiao"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca livre por nome ou endereço do estabelecimento.",
            "example": "santa casa"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "description": "Quantidade máxima de itens a retornar. Valores acima de 500 são limitados a 500.",
            "example": 50
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Deslocamento inicial para paginação.",
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitaisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/hospitais/v1/proximos": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Encontra o hospital mais próximo que oferece um atendimento",
        "description": "Devolve os hospitais dentro de um raio, ordenados da menor para a maior distância, cada um com <code>distancia_km</code>. Informe a origem de uma das três formas: <code>cep</code>, <code>latitude</code> com <code>longitude</code>, ou <code>municipio</code> com <code>uf</code>. Só entram hospitais com coordenada conhecida, hoje 99,7% do total. CEP malformado retorna 400 e CEP inexistente retorna 404.",
        "parameters": [
          {
            "name": "cep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "CEP de origem. Alternativo a `latitude`/`longitude` e a `municipio`/`uf`.",
            "example": "13280000"
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "description": "Latitude de origem. Deve ser usada junto de `longitude`.",
            "example": -22.9
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "description": "Longitude de origem. Deve ser usada junto de `latitude`.",
            "example": -47.05
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Município de origem. Deve ser usado junto de `uf`.",
            "example": "Campinas"
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "UF de origem. Deve ser usada junto de `municipio`.",
            "example": "SP"
          },
          {
            "name": "raio_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 200,
              "default": 50
            },
            "description": "Raio da busca em quilômetros.",
            "example": 50
          },
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "peconhentos",
                "oncologia",
                "raras"
              ]
            },
            "description": "Restringe a uma categoria inteira. Opcional e raramente necessário, já que <code>atendimento</code> identifica a vertical sozinho. Use para listar tudo de uma categoria, como todos os hospitais de oncologia de um estado.",
            "example": "peconhentos"
          },
          {
            "name": "atendimento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restringe a busca a um atendimento. Mesmos valores aceitos em <code>/hospitais/v1</code>; a lista completa está em <code>/hospitais/v1/opcoes</code>.",
            "example": "escorpiao"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            },
            "description": "Quantidade máxima de itens a retornar.",
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Deslocamento inicial para paginação.",
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitaisProximosResponse"
                }
              }
            }
          },
          "400": {
            "description": "Origem não informada ou parâmetro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/hospitais/v1/opcoes": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Lista todos os atendimentos que podem ser pesquisados",
        "description": "Ponto de partida da API. Lista os 27 atendimentos aceitos em <code>atendimento</code> — nove soros antiveneno, nove habilitações de oncologia e nove áreas de doenças raras — cada um com rótulo em português, grafias alternativas, códigos de portaria cobertos e quantos estabelecimentos o oferecem. Serve para montar seletores sem depender desta documentação.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpcoesResponse"
                }
              }
            }
          }
        },
        "parameters": []
      }
    },
    "/hospitais/v1/ciatox": {
      "get": {
        "tags": [
          "HOSPITAIS"
        ],
        "summary": "Lista os centros CIATOX de assistência toxicológica",
        "description": "Em acidente com animal peçonhento ou intoxicação, a orientação oficial é ligar ao CIATOX antes de ir ao hospital: eles confirmam qual unidade tem o soro no momento e orientam os primeiros cuidados. O Disque-Intoxicação nacional é 0800 722 6001.",
        "parameters": [
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "description": "Sigla da unidade federativa.",
            "example": "SP"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CiatoxResponse"
                }
              }
            }
          },
          "400": {
            "description": "UF inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HospitalFonte": {
        "title": "HospitalFonte",
        "description": "Procedência dos dados. `oficial` é sempre `false`: os dados vêm de documentos públicos do Ministério da Saúde, mas nem o MapaSUS nem a BrasilAPI são serviços oficiais do órgão.",
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "MapaSUS"
          },
          "url": {
            "type": "string",
            "example": "https://mapasus.com.br"
          },
          "oficial": {
            "type": "boolean",
            "example": false
          },
          "documentos_de_origem": {
            "type": "string",
            "example": "Ministério da Saúde — gov.br/saude"
          },
          "aviso": {
            "type": "string",
            "example": "O MapaSUS e a BrasilAPI não são serviços oficiais do Ministério da Saúde e não possuem vínculo com o órgão. Os dados são extraídos automaticamente de documentos públicos publicados pelo Ministério da Saúde e podem conter erros de extração ou estar desatualizados em relação à fonte oficial."
          }
        }
      },
      "Emergencia": {
        "title": "Emergencia",
        "description": "Orientação de segurança devolvida em toda resposta. Exiba para o usuário final em qualquer interface construída sobre estes dados.",
        "type": "object",
        "properties": {
          "aviso": {
            "type": "string",
            "example": "Esta API não substitui atendimento médico. Em emergência, ligue 192 (SAMU). Em caso de acidente com animal peçonhento ou intoxicação, ligue para o CIATOX da sua região antes de se deslocar — a unidade listada pode não ter o soro disponível no momento."
          },
          "samu": {
            "type": "string",
            "example": "192"
          },
          "disque_intoxicacao": {
            "type": "string",
            "example": "0800 722 6001"
          },
          "ciatox": {
            "type": "string",
            "example": "/api/hospitais/v1/ciatox"
          }
        }
      },
      "Atendimento": {
        "title": "Atendimento",
        "type": "object",
        "properties": {
          "vertical": {
            "type": "string",
            "example": "peconhentos"
          },
          "valor": {
            "type": "string",
            "description": "Valor a passar em `?atendimento=`.",
            "example": "Crotalic"
          },
          "rotulo": {
            "type": "string",
            "example": "Crotálico (cascavel)"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Outras grafias aceitas para o mesmo atendimento.",
            "example": [
              "crotalico",
              "crotalus",
              "cascavel"
            ]
          },
          "codigos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Códigos de portaria cobertos. Presente apenas nas habilitações de oncologia e doenças raras.",
            "example": [
              "12",
              "13"
            ]
          },
          "total": {
            "type": "integer",
            "description": "Quantidade de estabelecimentos que oferecem este atendimento.",
            "example": 1093
          }
        }
      },
      "OpcoesResponse": {
        "title": "OpcoesResponse",
        "type": "object",
        "properties": {
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:14:12.630Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "verticais": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "valor": {
                  "type": "string",
                  "example": "peconhentos"
                },
                "total": {
                  "type": "integer",
                  "example": 2018
                }
              }
            }
          },
          "atendimentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atendimento"
            }
          }
        }
      },
      "HospitalHabilitacao": {
        "title": "HospitalHabilitacao",
        "type": "object",
        "properties": {
          "specialty": {
            "type": "string",
            "example": "unacon"
          },
          "habilitado_em": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "qualification_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "17.07"
            ]
          }
        }
      },
      "Hospital": {
        "title": "Hospital",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 806
          },
          "state_code": {
            "type": "string",
            "example": "AC"
          },
          "city": {
            "type": "string",
            "example": "Acrelândia"
          },
          "name": {
            "type": "string",
            "example": "Unidade Mista de Saúde de Acrelândia"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "Avenida Paraná, 346 – Centro"
          },
          "phones": {
            "type": "string",
            "nullable": true,
            "example": "(68) 3235-1188"
          },
          "cnes": {
            "type": "string",
            "nullable": true,
            "description": "Código do estabelecimento no Cadastro Nacional de Estabelecimentos de Saúde.",
            "example": "5701929"
          },
          "treatments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Soros antiveneno disponíveis. Preenchido na vertical `peconhentos`.",
            "example": [
              "Bothropic",
              "Scorpionic",
              "Loxoscelic",
              "Phoneutric"
            ]
          },
          "specialties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HospitalHabilitacao"
            },
            "description": "Habilitações oficiais. Preenchido nas verticais `oncologia` e `raras`."
          },
          "verticals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "venomous_animals"
            ]
          },
          "lat": {
            "type": "number",
            "nullable": true,
            "example": -10.0783325
          },
          "lng": {
            "type": "number",
            "nullable": true,
            "example": -67.0558239
          },
          "extraction_source": {
            "type": "string",
            "description": "Como o registro foi extraído da fonte oficial: `pdf_text`, `pdf_ocr` ou `xlsx`.",
            "example": "pdf_text"
          },
          "requires_verification": {
            "type": "boolean",
            "description": "Indica extração de baixa confiança — o registro merece verificação manual antes de uso crítico.",
            "example": false
          }
        }
      },
      "HospitalProximo": {
        "title": "HospitalProximo",
        "allOf": [
          {
            "$ref": "#/components/schemas/Hospital"
          },
          {
            "type": "object",
            "properties": {
              "distancia_metros": {
                "type": "integer",
                "example": 18432
              },
              "distancia_km": {
                "type": "number",
                "example": 18.4
              }
            }
          }
        ]
      },
      "CiatoxCentro": {
        "title": "CiatoxCentro",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "state_code": {
            "type": "string",
            "example": "AM"
          },
          "name": {
            "type": "string",
            "example": "Centro de Informações Toxicológicas do Amazonas – CIT/AM"
          },
          "emergency_phone": {
            "type": "string",
            "nullable": true,
            "example": "(92) 3305-4702"
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "0800-722-6001",
              "(92) 3305-4732"
            ]
          },
          "source_url": {
            "type": "string",
            "example": "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-a-z/a/animais-peconhentos/ciatox"
          }
        }
      },
      "HospitaisResponse": {
        "title": "HospitaisResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total de registros que atendem ao filtro, antes da paginação.",
            "example": 245
          },
          "limit": {
            "type": "integer",
            "example": 100
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "description": "Data da última coleta do snapshot.",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hospital"
            }
          }
        }
      },
      "HospitaisProximosResponse": {
        "title": "HospitaisProximosResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 12
          },
          "limit": {
            "type": "integer",
            "example": 50
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "origem": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "example": -23.0299
              },
              "longitude": {
                "type": "number",
                "example": -46.9756
              }
            }
          },
          "raio_km": {
            "type": "number",
            "example": 50
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HospitalProximo"
            }
          }
        }
      },
      "CiatoxResponse": {
        "title": "CiatoxResponse",
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 32
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-11T05:00:00.000Z"
          },
          "fonte": {
            "$ref": "#/components/schemas/HospitalFonte"
          },
          "emergencia": {
            "$ref": "#/components/schemas/Emergencia"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CiatoxCentro"
            }
          }
        }
      }
    }
  }
}
