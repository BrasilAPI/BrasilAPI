{
    "tags": [
        {
            "name": "BANKS",
            "description": "Informações sobre sistema bancário"
        }
    ],
    "paths": {
        "/banks/v1": {
            "get": {
                "tags": ["BANKS"],
                "summary": "Retorna informações de todos os bancos do Brasil",
                "description": "Retorna uma lista com os dados de todos os bancos. Exemplo de uso: `GET https://brasilapi.com.br/api/banks/v1`.",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Bank"
                                    }
                                },
                                "example": [
                                    {
                                        "ispb": "00000000",
                                        "name": "BCO DO BRASIL S.A.",
                                        "code": 1,
                                        "fullName": "Banco do Brasil S.A."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        "/banks/v1/{code}": {
            "get": {
                "tags": [
                    "BANKS"
                ],
                "summary": "Busca as informações de um banco a partir de um código",
                "description": "Retorna os dados de um banco a partir do código informado. Exemplo de uso: `GET https://brasilapi.com.br/api/banks/v1/1`.",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "O código do banco<br />**Pode ser obtido <a href=\"#tag/BANKS/paths/~1banks~1v1/get\">nesse</a> endpoint**",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Bank"
                                },
                                "example": {
                                    "ispb": "00000000",
                                    "name": "BCO DO BRASIL S.A.",
                                    "code": 1,
                                    "fullName": "Banco do Brasil S.A."
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "O código do banco não foi encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorMessage"
                                },
                                "example": {
                                    "message": "Código bancário não encontrado",
                                    "type": "BANK_CODE_NOT_FOUND"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Bank": {
                "title": "Bank",
                "required": ["ispb", "name", "code", "fullName"],
                "type": "object",
                "properties": {
                    "ispb": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "code": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "fullName": {
                        "type": "string"
                    },
                    "cnpj": {
                        "type": "string",
                        "nullable": true,
                        "description": "CNPJ associado a instituicao para enriquecimento de endereco"
                    },
                    "headquarters_address": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "street": {
                                "type": "string",
                                "nullable": true
                            },
                            "number": {
                                "type": "string",
                                "nullable": true
                            },
                            "complement": {
                                "type": "string",
                                "nullable": true
                            },
                            "district": {
                                "type": "string",
                                "nullable": true
                            },
                            "city": {
                                "type": "string",
                                "nullable": true
                            },
                            "state": {
                                "type": "string",
                                "nullable": true
                            },
                            "zipCode": {
                                "type": "string",
                                "nullable": true
                            }
                        }
                    },
                    "address_source": {
                        "type": "string",
                        "nullable": true,
                        "enum": [
                            "bcb_sedes_exact_match",
                            "cnpj_exact_match",
                            "name_based_match"
                        ]
                    },
                    "address_last_sync": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "address_confidence": {
                        "type": "string",
                        "enum": ["high", "medium", "low", "none"]
                    }
                },
                "example": {
                    "ispb": "00000000",
                    "name": "BCO DO BRASIL S.A.",
                    "code": 1,
                    "fullName": "Banco do Brasil S.A.",
                    "cnpj": "00000000000191",
                    "headquarters_address": {
                        "street": "SBS QUADRA 1 BLOCO A",
                        "number": null,
                        "complement": "EDIFICIO SEDE I",
                        "district": "ASA SUL",
                        "city": "BRASILIA",
                        "state": "DF",
                        "zipCode": "70073-900"
                    },
                    "address_source": "bcb_sedes_exact_match",
                    "address_last_sync": "2026-06-30T00:00:00.000Z",
                    "address_confidence": "high"
                }
            }
        }
    }
}